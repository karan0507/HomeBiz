# HomeBiz Frontend Configuration

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Use mock data when backend is down (true/false)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Enable API calls on landing page (true/false)
NEXT_PUBLIC_ENABLE_LANDING_API=true

# Google Maps API Key (optional - not currently used, address input is manual)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Configuration (for Realtime features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
